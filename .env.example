# ─────────────────────────────────────────────────────────────
# Copy this file to  .env  and fill in the values.
# The .env file is git-ignored — your secrets never get committed.
# ─────────────────────────────────────────────────────────────

# REQUIRED: your Discord bot token.
# Get it at https://discord.com/developers/applications
#   → New Application → Bot → Reset Token → Copy.
DISCORD_TOKEN=

# REQUIRED: your Discord server (guild) ID.
# Enable Developer Mode in Discord (Settings → Advanced), then
# right-click your server icon → Copy Server ID.
DISCORD_GUILD_ID=

# REQUIRED: channel where new-internship pings are posted.
# Right-click a channel → Copy Channel ID.
CHANNEL_NEW_INTERNSHIPS=

# OPTIONAL: separate channels. If blank, everything posts to CHANNEL_NEW_INTERNSHIPS.
CHANNEL_NEW_SOURCES=
CHANNEL_RADAR_STATS=

# How often to re-check every watched site, in minutes.
CHECK_INTERVAL_MINUTES=30

# Ping @everyone when a new internship is found? true / false.
# (The bot's role also needs the "Mention @everyone" permission in Discord.)
PING_EVERYONE=true

# Which listings you care about. Comma-separated keywords matched against
# the job title + category. Leave as-is for software / AI / data roles.
RELEVANCE_KEYWORDS=software,swe,developer,machine learning,ml,ai,artificial intelligence,data,ml engineer,full stack,backend,frontend,computer

# Only notify for these terms (comma-separated substrings, matched loosely).
# Leave blank to allow every term.
TERM_FILTER=2027

# OPTIONAL personal feed. This is the interninsider.me link you pasted —
# it contains a PERSONAL token, so it lives here (git-ignored), never in code.
# Consider rotating it since it was shared in plaintext.
INTERNINSIDER_URL=
